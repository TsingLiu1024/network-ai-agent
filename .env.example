# Canonical name; legacy LLM_PROVIDER remains accepted.
MODEL_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b
# Container + host Ollama: OLLAMA_URL=http://host.docker.internal:11434

# MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Set a long random value before exposing the API beyond localhost.
API_KEY=
ENABLE_RAG=true
KNOWLEDGE_PATH=knowledge
VECTOR_DB_PATH=vector_db
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Default forbids downloads at service startup. Explicitly preload the model.
EMBEDDING_LOCAL_ONLY=true
RAG_TOP_K=3
RAG_MIN_SCORE=0.3
RAG_LOCK_TIMEOUT=10
RAG_MAX_FILE_BYTES=2000000
RAG_MAX_TOTAL_BYTES=10000000

# Opt in only when diagnosing the host running this API.
COLLECT_LOCAL_EVIDENCE=false
# Required in addition when sending local evidence to OpenAI/DeepSeek.
ALLOW_CLOUD_LOG_UPLOAD=false
LLM_TIMEOUT=30
DIAGNOSIS_TIMEOUT=75
TOOL_TIMEOUT=5
MAX_CONCURRENT_DIAGNOSES=2
ENABLE_TOKEN_OPTIMIZER=true
MAX_CONTEXT_LENGTH=12000
MAX_LLM_OUTPUT_CHARS=8000
